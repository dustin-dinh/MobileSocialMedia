generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String         @id @default(uuid())
  username              String         @unique
  email                 String         @unique
  passwordHash          String?
  googleId              String?        @unique
  emailVerifiedAt       DateTime?
  displayName           String?
  avatarUrl             String?
  bio                   String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  posts                 Post[]
  reposts               Repost[]
  followers             Follow[]       @relation("followers")
  following             Follow[]       @relation("following")
  likes                 Like[]
  comments              Comment[]
  notificationsSent     Notification[] @relation("NotificationActor")
  notificationsReceived Notification[] @relation("NotificationRecipient")
  authTokens            AuthToken[]
  onboardedAt           DateTime?
  blocking              Block[]        @relation("Blocker")
  blockedBy             Block[]        @relation("Blocked")
  reports               Report[]
  saves                 Save[]
  commentLikes          CommentLike[]
  hiddenPosts           HiddenPost[]
  deviceTokens          DeviceToken[]
  interactions          ContentInteraction[]
  coverUrl              String?
  // Tài khoản riêng tư: chỉ người theo dõi mới xem được bài; theo dõi phải được duyệt.
  isPrivate             Boolean        @default(false)
  // USER | ADMIN
  role                  String         @default("USER")
  bannedAt              DateTime?
  followRequestsSent     FollowRequest[] @relation("FollowRequester")
  followRequestsReceived FollowRequest[] @relation("FollowRequestTarget")
  conversationsAsA      Conversation[] @relation("ConversationUserA")
  conversationsAsB      Conversation[] @relation("ConversationUserB")
  messages              Message[]
  stories               Story[]
  storyViews            StoryView[]
}

model Post {
  id            String         @id @default(cuid())
  authorId      String
  content       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  comments      Comment[]
  likes         Like[]
  notifications Notification[]
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media         PostMedia[]
  privacy PostPrivacy @default(PUBLIC)
  reposts       Repost[]
  saves         Save[]
  hiddenBy      HiddenPost[]
  // Video dọc, tối đa 60 giây: đủ điều kiện xuất hiện trong luồng Reels.
  reelEligible  Boolean        @default(false)
  interactions  ContentInteraction[]

  @@index([authorId, createdAt])
  @@index([reelEligible, createdAt])
}

model PostMedia {
  id     String @id @default(cuid())
  postId String
  type   String
  order  Int    @default(0)
  url    String
  // Chỉ có ở video; ảnh cũ để trống.
  thumbnailUrl String?
  width        Int?
  height       Int?
  durationMs   Int?
  sizeBytes    Int?
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, order])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Like {
  userId    String
  postId    String
  // LIKE | LOVE | HAHA | WOW | SAD | ANGRY
  type      String   @default("LIKE")
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id            String         @id @default(cuid())
  content       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  postId        String
  userId        String
  parentId      String?
  parent        Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("CommentReplies")
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
  editedAt      DateTime?
  likes         CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([userId])
}

model Notification {
  id          String    @id @default(cuid())
  type        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  recipientId String
  actorId     String
  postId      String?
  commentId   String?
  actor       User      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  comment     Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post        Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  attemptCount Int @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

enum PostPrivacy {
  PUBLIC
  FRIENDS
  PRIVATE
}


model Repost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String // POST | COMMENT | USER
  targetId   String
  reason     String
  note       String?
  status     String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId])
}

model Save {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
}

model CommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

model HiddenPost {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model DeviceToken {
  token     String   @id
  userId    String
  platform  String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Nhật ký xem Reels (đầu vào cho xếp hạng). id do thiết bị sinh ra để gửi lại không bị đếm trùng.
model ContentInteraction {
  id         String   @id
  userId     String
  postId     String
  mediaId    String?
  eventType  String
  watchMs    Int?
  durationMs Int?
  surface    String
  requestId  String?
  position   Int?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([postId, createdAt])
}

// Yêu cầu theo dõi một tài khoản riêng tư, chờ chủ tài khoản duyệt.
model FollowRequest {
  requesterId String
  targetId    String
  createdAt   DateTime @default(now())

  requester User @relation("FollowRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("FollowRequestTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([requesterId, targetId])
  @@index([targetId, createdAt])
}

// Hội thoại 1:1. Cặp người dùng được sắp xếp (userAId < userBId) để mỗi cặp chỉ có một dòng.
model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  // Thời điểm mỗi bên đọc gần nhất: dùng để tính số chưa đọc và hiện "Đã xem".
  userAReadAt   DateTime?
  userBReadAt   DateTime?

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

// id do thiết bị sinh ra để gửi lại khi mất mạng không tạo tin trùng.
model Message {
  id             String   @id
  conversationId String
  senderId       String
  content        String?
  imageUrl       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Tin 24 giờ: ảnh hoặc video ngắn, hết hạn sau expiresAt.
model Story {
  id           String   @id @default(cuid())
  authorId     String
  type         String // image | video
  url          String
  thumbnailUrl String?
  durationMs   Int?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views  StoryView[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  storyId   String
  viewerId  String
  createdAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId])
}
