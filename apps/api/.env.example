# Runtime: Supabase Transaction Pooler URL (normally port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Prisma CLI: Supabase Session/Direct Pooler URL (normally port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Local development only. Use a long random value in your untracked .env.
JWT_SECRET="replace-with-a-local-development-secret"
PORT=3000
