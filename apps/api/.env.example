# Runtime: Supabase Transaction Pooler URL (normally port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Prisma CLI: Supabase Session/Direct Pooler URL (normally port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Local development only. Use a long random value in your untracked .env.
JWT_SECRET="replace-with-a-local-development-secret"
PORT=3000



# Google OAuth
GOOGLE_WEB_CLIENT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
EMAIL_VERIFICATION_URL=

OTP_HASH_SECRET=

# File storage (S3 API). Local development: MinIO from docker-compose.yml at the repository root.
# Deploy: point these at AWS S3, Cloudflare R2 or any S3-compatible service.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=social-media
# Bucket with no public read, for chat images; clients get time-limited signed URLs.
# Created on startup when missing. Defaults to "<S3_BUCKET>-private".
S3_PRIVATE_BUCKET=
# Optional fixed public base URL of the bucket (CDN / custom domain). Leave empty in local
# development: URLs then use the host the phone used to reach the API.
S3_PUBLIC_URL=

# Blurring of sensitive chat images (docs/moderation/MODERATION_PLAN.md).
# Model: node scripts/download-moderation-model.cjs (stored in models/, not in git).
IMAGE_MODERATION_MODEL_DIR=
# NSFW probability at or above which an image is blurred for the recipient.
IMAGE_MODERATION_THRESHOLD=0.7
# true: refuse chat images while the model is missing, instead of sending them unblurred.
IMAGE_MODERATION_REQUIRED=false
